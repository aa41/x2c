<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/page_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page_background"
    android:clipToPadding="false"
    android:fillViewport="true">

<LinearLayout
    android:id="@+id/content_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_page"
    android:paddingTop="@dimen/space_large"
    android:paddingEnd="@dimen/space_page"
    android:paddingBottom="@dimen/space_page">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/remote_hero"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:adjustViewBounds="true"
            android:background="@drawable/brand_tile"
            android:clipToOutline="true"
            android:contentDescription="@string/hero_description"
            android:scaleType="centerCrop"
            android:src="@drawable/hero" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_medium"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/brand_name"
                android:textColor="@color/ink"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/brand_caption"
                android:textColor="@color/muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_background"
            android:paddingStart="@dimen/space_medium"
            android:paddingTop="6dp"
            android:paddingEnd="@dimen/space_medium"
            android:paddingBottom="6dp"
            android:text="@string/jar_badge"
            android:textColor="@color/primary"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_large"
        android:background="@drawable/login_card"
        android:elevation="3dp"
        android:orientation="vertical"
        android:padding="@dimen/space_page">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_title"
            android:textColor="@color/ink"
            android:textSize="@dimen/title_size" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/login_subtitle"
            android:textColor="@color/muted"
            android:textSize="@dimen/body_size" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:text="@string/email_label"
            android:textColor="@color/ink"
            android:textSize="@dimen/label_size" />

        <dev.x2c.fixture.producer.widget.LoginInputView
            android:id="@+id/email_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_small"
            android:background="@drawable/input_background"
            android:contentDescription="@string/email_description"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            app:hintText="@string/email_hint"
            app:inputMode="33" />

        <TextView
            android:id="@+id/email_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="请输入有效的邮箱地址"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:text="@string/password_label"
            android:textColor="@color/ink"
            android:textSize="@dimen/label_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/space_small"
            android:background="@drawable/input_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <dev.x2c.fixture.producer.widget.LoginInputView
                android:id="@+id/password_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/password_description"
                android:paddingStart="12dp"
                android:paddingEnd="8dp"
                app:hintText="@string/password_hint"
                app:inputMode="129" />

            <TextView
                android:id="@+id/password_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/show_password"
                android:focusable="true"
                android:padding="12dp"
                android:text="@string/show_password"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/password_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="密码至少需要 6 位"
            android:textColor="@color/error"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/remember_toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clickable="true"
                android:contentDescription="记住登录状态"
                android:focusable="true"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/remember_me"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/forgot_password"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:contentDescription="@string/forgot_password"
                android:focusable="true"
                android:padding="8dp"
                android:text="@string/forgot_password"
                android:textColor="@color/primary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@drawable/login_button_state"
            android:clickable="true"
            android:contentDescription="@string/login_action"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/login_action"
            android:textColor="@color/surface"
            android:textSize="@dimen/button_size" />

        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:padding="10dp"
            android:text="登录状态"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fill_demo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:clickable="true"
            android:contentDescription="@string/fill_demo"
            android:focusable="true"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/fill_demo"
            android:textColor="@color/primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/demo_account"
            android:textColor="@color/subtle"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:gravity="center"
            android:text="@string/or_continue"
            android:textColor="@color/subtle"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/wechat_login"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_button_state"
                android:clickable="true"
                android:contentDescription="使用微信登录"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/wechat_login"
                android:textColor="@color/ink"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/github_login"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/secondary_button_state"
                android:clickable="true"
                android:contentDescription="使用 GitHub 登录"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/github_login"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/privacy_link"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:clickable="true"
            android:contentDescription="隐私政策"
            android:focusable="true"
            android:gravity="center"
            android:padding="6dp"
            android:text="@string/privacy_copy"
            android:textColor="@color/muted"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/matrix_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical" />

    <dev.x2c.fixture.producer.widget.FlowLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_medium"
        android:padding="@dimen/space_small">

        <TextView
            android:id="@+id/runtime_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/runtime_chip"
            android:textColor="@color/subtle"
            android:textSize="11sp"
            app:layout_breakBefore="true"
            app:layout_columnSpan="@integer/max_items"
            app:layout_itemGravity="center" />
    </dev.x2c.fixture.producer.widget.FlowLayout>

    <TextView
        android:id="@+id/close_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:contentDescription="@string/close_page"
        android:focusable="true"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/close_page"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <dev.x2c.fixture.producer.widget.ContextBadgeView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone" />

    <view
        class="dev.x2c.fixture.producer.widget.AttrsBadgeView"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone" />

    <dev.x2c.fixture.producer.widget.StatusPillView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        app:accentColor="@color/accent"
        app:emphasized="@bool/feature_enabled"
        app:heroAsset="@drawable/hero"
        app:label="@string/headline"
        app:maxItems="@integer/max_items"
        app:opacityFactor="0.75"
        app:panelDrawable="@drawable/panel_background"
        app:spacing="@dimen/space_small" />
</LinearLayout>
</ScrollView>
