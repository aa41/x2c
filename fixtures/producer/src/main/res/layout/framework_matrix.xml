<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/matrix_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/matrix_outline"
    android:clipChildren="false"
    android:orientation="vertical"
    android:padding="16dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:clipToPadding="false">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/matrix_gradient"
            android:gravity="center"
            android:text="@string/matrix_title"
            android:textColor="@color/surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="8dp"
            android:text="@string/matrix_subtitle"
            android:textColor="@color/surface"
            android:textSize="10sp" />
    </FrameLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:layout_marginTop="12dp"
        android:background="@color/primary_soft"
        android:padding="10dp">

        <TextView
            android:id="@id/declared_anchor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Synthetic ID anchor"
            android:textColor="@color/ink"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/relative_result"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignBaseline="@id/declared_anchor"
            android:layout_alignParentEnd="true"
            android:layout_marginStart="12dp"
            android:text="@string/matrix_result"
            android:textColor="@color/primary"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/border" />
    </RelativeLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alignmentMode="alignMargins"
        android:columnCount="2"
        android:orientation="horizontal"
        android:rowCount="3"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/matrix_action"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="0"
            android:background="@drawable/matrix_action_state"
            android:text="@string/matrix_action"
            android:textAllCaps="false"
            android:textColor="@color/matrix_text" />

        <CheckBox
            android:id="@+id/matrix_check"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_column="1"
            android:layout_row="0"
            android:buttonTint="@color/primary"
            android:checked="true"
            android:text="CheckBox"
            android:textColor="@color/ink" />

        <ProgressBar
            android:id="@+id/matrix_progress"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_column="0"
            android:layout_columnSpan="2"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="1"
            android:indeterminate="false"
            android:max="@integer/matrix_max_progress"
            android:progress="25"
            android:progressTint="@color/primary" />

        <SeekBar
            android:id="@+id/matrix_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_column="0"
            android:layout_columnWeight="1"
            android:layout_gravity="fill"
            android:layout_row="2"
            android:max="100"
            android:progress="40"
            android:thumb="@drawable/matrix_oval" />

        <RatingBar
            android:id="@+id/matrix_rating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_column="1"
            android:layout_row="2"
            android:isIndicator="false"
            android:numStars="3"
            android:rating="2"
            android:stepSize="1" />
    </GridLayout>

    <TableLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:shrinkColumns="1"
        android:stretchColumns="1">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="0"
                android:padding="6dp"
                android:text="R2.id"
                android:textColor="@color/muted" />
            <TextView
                android:id="@+id/id_value_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_column="1"
                android:padding="6dp"
                android:text="0x00000000"
                android:textColor="@color/ink" />
        </TableRow>

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="values"
                android:textColor="@color/muted" />
            <TextView
                android:id="@+id/value_matrix_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="6dp"
                android:text="arrays · plurals · fractions"
                android:textColor="@color/ink" />
        </TableRow>
    </TableLayout>

    <RadioGroup
        android:id="@+id/matrix_radio_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checkedButton="@id/radio_class"
        android:orientation="horizontal">
        <RadioButton
            android:id="@+id/radio_xml"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="XML" />
        <RadioButton
            android:id="@+id/radio_class"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Class" />
        <RadioButton
            android:id="@+id/radio_dex"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DEX" />
    </RadioGroup>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:fillViewport="true"
        android:smoothScrollingEnabled="true">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ToggleButton
                android:id="@+id/matrix_toggle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Toggle" />
            <Switch
                android:id="@+id/matrix_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:checked="true"
                android:text="异步图片" />
            <ImageButton
                android:id="@+id/matrix_image_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/matrix_inset"
                android:contentDescription="图片按钮"
                android:scaleType="centerInside"
                android:src="@drawable/matrix_oval" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
