<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFFFFF" android:focusableInTouchMode="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp"
        android:gravity="center_vertical" android:paddingLeft="18dp" android:paddingRight="4dp">
        <TextView android:id="@+id/video_avatar" android:layout_width="38dp" android:layout_height="38dp"
            android:gravity="center" android:text="登录" android:textColor="#FF85AC"
            android:textSize="12sp" android:textStyle="bold" android:background="@drawable/video_login"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="34dp"
            android:layout_marginLeft="15dp" android:layout_marginRight="12dp"
            android:gravity="center_vertical" android:background="@drawable/video_search_border">
            <ImageView android:id="@+id/video_search_go" android:layout_width="30dp" android:layout_height="match_parent"
                android:padding="7dp" android:contentDescription="搜索"/>
            <EditText android:id="@+id/video_search" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="match_parent" android:background="#00FFFFFF" android:padding="0dp"
                android:paddingRight="8dp" android:hint="绝区零联动杯子" android:textColorHint="#676B73"
                android:textColor="#222326" android:textSize="15sp" android:singleLine="true" android:imeOptions="actionSearch"/>
        </LinearLayout>
        <ImageView android:id="@+id/video_games" android:layout_width="43dp" android:layout_height="44dp"
            android:padding="10dp" android:contentDescription="游戏分区"/>
        <ImageView android:id="@+id/video_messages" android:layout_width="43dp" android:layout_height="44dp"
            android:padding="10dp" android:contentDescription="消息"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="38dp">
        <HorizontalScrollView android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:id="@+id/video_channels" android:layout_width="wrap_content"
                android:layout_height="match_parent" android:gravity="center_vertical"/>
        </HorizontalScrollView>
        <ImageView android:id="@+id/video_channel_menu" android:layout_width="44dp" android:layout_height="match_parent"
            android:padding="12dp" android:contentDescription="分区导航"/>
    </LinearLayout>
    <ScrollView android:id="@+id/video_scroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" android:background="#F1F2F3">
        <LinearLayout android:id="@+id/video_feed" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="5dp"/>
    </ScrollView>
    <View android:layout_width="match_parent" android:layout_height="0.5dp" android:background="#EEEEEE"/>
    <LinearLayout android:id="@+id/video_bottom" android:layout_width="match_parent" android:layout_height="48dp"
        android:gravity="center" android:background="#FFFFFF"/>
</LinearLayout>
