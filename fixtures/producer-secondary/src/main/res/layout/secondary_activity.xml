<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/shop_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/secondary_page"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/shop_page_padding"
        android:paddingTop="12dp"
        android:paddingEnd="@dimen/shop_page_padding"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shop_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/shop_card"
                android:clickable="true"
                android:contentDescription="返回"
                android:focusable="true"
                android:gravity="center"
                android:text="‹"
                android:textColor="@color/secondary_ink"
                android:textSize="30sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/shop_title"
                android:textColor="@color/secondary_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shop_favorite"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/shop_card"
                android:clickable="true"
                android:contentDescription="收藏商品"
                android:focusable="true"
                android:gravity="center"
                android:text="♡"
                android:textColor="@color/secondary_accent"
                android:textSize="24sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="380dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/shop_image_placeholder"
            android:clipChildren="true"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/product_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:contentDescription="@string/image_description"
                android:scaleType="centerCrop"
                android:src="@drawable/product_hero" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_margin="14dp"
                android:background="@drawable/shop_chip_selected"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="CDN · SHA-256 VERIFIED"
                android:textColor="@color/secondary_surface"
                android:textSize="10sp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/image_retry"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/shop_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="重新加载"
                android:textColor="@color/secondary_ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/image_cancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/shop_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="取消请求"
                android:textColor="@color/secondary_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/image_failure"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/shop_outline"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="故障 URL"
                android:textColor="@color/secondary_error"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/image_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/image_initial_status"
            android:textColor="@color/secondary_muted"
            android:textIsSelectable="true"
            android:textSize="11sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/product_title"
            android:textColor="@color/secondary_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/product_subtitle"
            android:textColor="@color/secondary_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_symbol"
                android:textColor="@color/secondary_accent"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/product_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/price_value"
                android:textColor="@color/secondary_accent"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingBottom="4dp"
                android:text="@string/price_original"
                android:textColor="@color/secondary_muted"
                android:textSize="13sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:paddingBottom="4dp"
                android:text="@string/sales_copy"
                android:textColor="@color/secondary_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/shop_chip"
            android:paddingStart="10dp"
            android:paddingTop="6dp"
            android:paddingEnd="10dp"
            android:paddingBottom="6dp"
            android:text="@string/coupon_copy"
            android:textColor="@color/secondary_accent_dark"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/shop_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/shop_card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择颜色"
                android:textColor="@color/secondary_ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sku_caramel"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/shop_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="焦糖棕"
                    android:textColor="@color/secondary_surface"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sku_cream"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/shop_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="奶油白"
                    android:textColor="@color/secondary_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/sku_black"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/shop_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="曜石黑"
                    android:textColor="@color/secondary_ink"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="购买数量"
                    android:textColor="@color/secondary_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quantity_minus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shop_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="−"
                    android:textColor="@color/secondary_ink"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/quantity_value"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/secondary_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/quantity_plus"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/shop_outline"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="+"
                    android:textColor="@color/secondary_ink"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/shop_card"
            android:orientation="vertical"
            android:padding="@dimen/shop_card_padding">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="今日付款，预计明日送达 · 运费险已赠送"
                android:textColor="@color/secondary_ink"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="7 天无理由 · 48 小时发货 · 正品保障"
                android:textColor="@color/secondary_success"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shop_action_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:accessibilityLiveRegion="polite"
            android:background="@drawable/shop_chip"
            android:gravity="center"
            android:padding="12dp"
            android:text="请选择规格与数量"
            android:textColor="@color/secondary_accent_dark"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cart_badge"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/shop_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="购物车\n0"
                android:textColor="@color/secondary_ink"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/add_to_cart"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/shop_chip"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="加入购物车"
                android:textColor="@color/secondary_accent_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/buy_now"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/shop_buy"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="立即购买"
                android:textColor="@color/secondary_surface"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
